+            # EXPERIMENT 2026-07-27: JOINT product norm. W and S_k are
+            # correlated (flux big -> deposits big -> gradients big), so
+            # normalizing them separately does not normalize the product;
+            # the correlation grows down-cascade and cancels the k^H_h
+            # ladder. Normalize the PRODUCT W*S_k per level by its mean
+            # absolute value over turbulon centers, enforcing the mean
+            # turbulon amplitude <|A|> = C_k exactly.
+            W *= S_k            # joint pattern W*S_k (sparse at centers)
+            inner = _inner_view(W, window)
+            level_sum = np.abs(inner).sum(axis=(0, 1), dtype=np.float64)
+            level_cnt = np.count_nonzero(inner, axis=(0, 1))
+            level_mean = (level_sum / np.maximum(level_cnt, 1)).astype(np.float32)
+            W /= np.where(level_mean > 0, level_mean, np.float32(1.0))[None, None, :]
 
             # Bound taper, applied AFTER the norm: proximity of one part of
